{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": [
                "^\\.github/workflows/.+\\.ya?ml$"
            ],
            "matchStrings": [
                "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+-\\s+[\"']?(?<currentValue>\\S+?)[\"']?\\s"
            ]
        }
    ]
}