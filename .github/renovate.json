{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base"
    ],
    "baseBranches": [ "main" ],
    "rebaseWhen": "conflicted",
    "labels": [ "dependencies" ],
    "dependencyDashboard": true,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "^\\.github/workflows/.+\\.ya?ml$"
            ],
            "matchStrings": [
                "-\\s+[\"']?(?<currentValue>[^\"'\\s]+)[\"']?\\s+#\\s+renovate:\\s+datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?"
            ]
        }
    ],
    "packageRules": [
        {
            "matchDatasources": [ "docker" ],
            "matchPackageNames": [ "splunk/splunk" ],
            "separateMinorPatch": true,
            "groupName": "splunk releases"
        }
    ]
}