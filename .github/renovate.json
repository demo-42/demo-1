{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [ "config:recommended" ],
    "baseBranches": [ "main" ],
    "rebaseWhen": "conflicted",
    "labels": [ "dependency-update" ],
    "dependencyDashboard": true,
    "reviewersFromCodeOwners": true,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/"
            ],
            "matchStrings": [
                "-\\s+\"(?<currentValue>[^\"]+)\"\\s+#\\s+renovate:\\s+datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
            ],
            "versioningTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": "Open PR of Splunk Docker minor / patch releases",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "splunk/splunk"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "Splunk Minor and Patch Releases"
        },
        {
            "description": "Notify about new Splunk Docker major releases via Dependency Dashboard",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "splunk/splunk"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true,
            "groupName": "Splunk Major Releases"
        }
    ]
}