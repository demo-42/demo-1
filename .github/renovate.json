{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base"
    ],
    "dependencyDashboard": true,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "^\\.github/workflows/.+\\.ya?ml$"
            ],
            "matchStrings": [
                "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+-\\s+[\"']?(?<currentValue>\\S+?)[\"']?\\s"
            ]
        }
    ],
    "packageRules": [
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "splunk/splunk"
            ],
            "separateMinorPatch": true,
            "groupName": "splunk versions"
        }
    ]
}